# Non-secret FarmWiz Orchestrator runtime settings.
# Install as /etc/farmwiz-orchestrator/orchestrator.env with root ownership and mode 0600.
NODE_ENV=production
PORT=7100
HTTPS_ENABLED=true
HTTPS_PORT=443
BIND_HOST=192.168.100.82
NEEDLE_URL=http://127.0.0.1:7101
CONFIG_DIR=/etc/farmwiz-orchestrator
TLS_CERT_FILE=/etc/farmwiz-orchestrator/tls/server.crt
TLS_KEY_FILE=/etc/farmwiz-orchestrator/tls/server.key
DEVICES_FILE=/etc/farmwiz-orchestrator/devices.json
DEFAULT_TB_BASE_URL=https://dash.farmwiz.net
TRUST_PROXY=false

# MQTT upstream and namespace. Device-specific topic paths remain in devices.json.
MQTT_ENABLED=true
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_ROOT=farmwiznet/
MQTT_DISCOVERY_TIMEOUT_MS=5000

# Do not put MQTT_USERNAME or MQTT_PASSWORD in this tracked template.
