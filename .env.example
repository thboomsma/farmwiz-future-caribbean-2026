APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8090
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_provider_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
LOCAL_ICM_URL=http://your-local-relay
LOCAL_ICM_TOKEN=your_local_relay_token_here
AI_DAILY_CALL_LIMIT=20
AI_MIN_INTERVAL_SECONDS=30
THINGSBOARD_URL=https://your-thingsboard-server
THINGSBOARD_USERNAME=your_username
THINGSBOARD_PASSWORD=your_password
FARMWIZ_TB_ALARM_SYNC=false

